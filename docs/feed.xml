---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title type="text">{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip | normalize_whitespace | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {% assign posts = site.posts | where_exp: "post", "post.draft != true" | sort: "date" | reverse %}
  {% assign posts_limit = site.feed.posts_limit | default: 10 %}
  {% for post in posts limit: posts_limit %}
  <entry>
    <title type="text">{{ post.title | strip_html | xml_escape }}</title>
    <link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.modified_date | default: post.date | date_to_xmlschema }}</updated>
    <author><name>{{ post.author | default: site.author.name | join: ', ' | xml_escape }}</name></author>
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}" />{% endfor %}
    <summary type="text">{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
    {% capture feed_content %}{% include feed-content.html post=post %}{% endcapture %}
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ feed_content | strip | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
